{
  "name": "cliproxy-dashboard",
  "version": "1.0.0",
  "type": "module",
  "description": "Standalone Cliproxy Dashboard",
  "main": "dist/cliproxy-dashboard.js",
  "scripts": {
    "dev": "vite --config frontend/vite.config.ts",
    "dev:server": "tsx src/cliproxy-dashboard.ts --host 127.0.0.1 --port 60949 --no-port-fallback",
    "build": "pnpm run build:server && pnpm run build:frontend",
    "build:server": "tsc -p tsconfig.json",
    "build:frontend": "vite build --config frontend/vite.config.ts",
    "preview": "vite preview --config frontend/vite.config.ts",
    "start": "node dist/cliproxy-dashboard.js",
    "typecheck": "pnpm run typecheck:server && pnpm run typecheck:frontend",
    "typecheck:server": "tsc -p tsconfig.json --noEmit",
    "typecheck:frontend": "tsc -p frontend/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "yaml": "^2.3.4"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vite": "^8.1.3",
    "vitest": "^1.0.0"
  }
}
